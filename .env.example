# Copy this file to .env and fill in what you want to use.
# .env is gitignored and must never be committed.

# Optional. Enables AI-generated natural-language summaries of your meal plan.
# Leave unset and the app still works - it falls back to a templated summary.
OPENAI_API_KEY=

# Optional. Enables saving generated plans and viewing past ones.
# Leave unset and the app runs exactly as before, without history.
# Example: postgresql://dietbot_app:<your-local-password>@localhost:5432/dietbot
DIETBOT_DB_URL=
